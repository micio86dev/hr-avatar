{
    "openapi": "3.1.2",
    "info": {
        "title": "HR-Avatar",
        "version": "0.1.0",
        "description": "HTTP API of the HR-Avatar avatar conversation engine: create, drive and tear down real-time avatar conversations.",
        "contact": {
            "name": "HR-Avatar API"
        }
    },
    "servers": [
        {
            "url": "/v1"
        }
    ],
    "tags": [
        {
            "name": "API keys"
        },
        {
            "name": "Credentials"
        },
        {
            "name": "Health"
        }
    ],
    "paths": {
        "/api-keys": {
            "get": {
                "operationId": "api-keys.index",
                "description": "The account's keys, newest first. Neither the key nor its hash is ever returned after creation.",
                "summary": "List API keys",
                "tags": [
                    "API keys"
                ],
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "maxLength": 512
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated set of `ApiKeyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ApiKeyResource"
                                            }
                                        },
                                        "next_cursor": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "The \"cursor\" that points to the next set of items."
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "next_cursor"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            },
            "post": {
                "operationId": "api-keys.store",
                "description": "The response carries the full `key` once; it cannot be retrieved afterwards. A secret key\nneeds an explicit scope list, a publishable key needs 1 to 20 allowed origins. A key can only\nissue keys of its own mode and, unless it holds `*`, only scopes it holds itself.",
                "summary": "Create an API key",
                "tags": [
                    "API keys"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateApiKeyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`IssuedApiKeyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IssuedApiKeyResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "403": {
                        "description": "The caller lacks a requested scope (`insufficient_scope`) or asked for the other mode (`forbidden`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/api-keys/{apiKey}/revoke": {
            "post": {
                "operationId": "api-keys.revoke",
                "description": "Takes effect at once. Revoking a key that is already revoked changes nothing and keeps the\noriginal `revoked_at`. Revoking only removes access, so unlike create and rotate it needs\nno scope or mode comparison with the caller: any key with `api_keys:manage` may revoke any\nkey of the account, itself included. The way back from a lockout is the `hra:issue-key` command.",
                "summary": "Revoke an API key",
                "tags": [
                    "API keys"
                ],
                "parameters": [
                    {
                        "name": "apiKey",
                        "in": "path",
                        "required": true,
                        "description": "The api key ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`ApiKeyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiKeyResource"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/api-keys/{apiKey}/rotate": {
            "post": {
                "operationId": "api-keys.rotate",
                "description": "Issues a successor with the same type, mode, scopes and origins, returned once as `key`. The\nsuccessor does not inherit an expiry: it has none until one is set by creating a key instead.\nThe old key keeps working for `overlap_seconds` (default 3600, 0 revokes it immediately) and never\noutlives an expiry it already had. A revoked or expired key cannot be rotated.",
                "summary": "Rotate an API key",
                "tags": [
                    "API keys"
                ],
                "parameters": [
                    {
                        "name": "apiKey",
                        "in": "path",
                        "required": true,
                        "description": "The api key ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RotateApiKeyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`IssuedApiKeyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IssuedApiKeyResource"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "403": {
                        "description": "The key carries a scope the caller lacks (`insufficient_scope`) or is of the other mode (`forbidden`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The key is revoked or expired (`invalid_state`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/provider-credentials": {
            "get": {
                "operationId": "provider-credentials.index",
                "description": "One entry per credential provider. `source` says whose key a call would use: `account` (the\naccount stored one), `platform` (only the platform key is set) or `none`. `last_four` is\nshown only for an account key of 12 characters or more.",
                "summary": "List provider credentials",
                "tags": [
                    "Credentials"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "provider": {
                                                        "type": "string"
                                                    },
                                                    "source": {
                                                        "$ref": "#/components/schemas/CredentialSource"
                                                    },
                                                    "last_four": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "provider",
                                                    "source",
                                                    "last_four"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/provider-credentials/{provider}": {
            "put": {
                "operationId": "provider-credentials.update",
                "description": "Creates or replaces the account's key for the provider. The key is encrypted at rest and is\nnever returned; the answer shows only its last four characters.",
                "summary": "Store a provider credential",
                "tags": [
                    "Credentials"
                ],
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PutCredentialRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`ProviderCredentialResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProviderCredentialResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            },
            "delete": {
                "operationId": "provider-credentials.destroy",
                "description": "Idempotent: removing a key that is not stored answers 204 as well. Calls then use the\nplatform key, if one is set.",
                "summary": "Remove a provider credential",
                "tags": [
                    "Credentials"
                ],
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/llm-credentials": {
            "get": {
                "operationId": "llm-credentials.index",
                "description": "The account's stored keys, shown as the provider and the last four characters of the key (null\nfor a key under 12 characters).",
                "summary": "List language-model credentials",
                "tags": [
                    "Credentials"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `LlmCredentialResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/LlmCredentialResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/llm-credentials/{llmProvider}": {
            "put": {
                "operationId": "llm-credentials.update",
                "description": "Creates or replaces the account's key for a provider that appears in the model catalogue (404\notherwise). The key is encrypted at rest and never returned.",
                "summary": "Store a language-model credential",
                "tags": [
                    "Credentials"
                ],
                "parameters": [
                    {
                        "name": "llmProvider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PutCredentialRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`StoredLlmCredentialResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StoredLlmCredentialResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "404": {
                        "description": "The provider does not appear in the model catalogue.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            },
            "delete": {
                "operationId": "llm-credentials.destroy",
                "description": "Idempotent: answers 204 whether or not a key was stored. A conversation whose config binds a\nmodel of this provider then fails to connect with `llm_credential_missing`.",
                "summary": "Remove a language-model credential",
                "tags": [
                    "Credentials"
                ],
                "parameters": [
                    {
                        "name": "llmProvider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/llm-models": {
            "get": {
                "operationId": "llm-models.index",
                "description": "The enabled entries of the platform catalogue. The catalogue is the same for every account\nand cannot be changed through the API.",
                "summary": "List language models",
                "tags": [
                    "Credentials"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `LlmModelResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/LlmModelResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "secretKey": []
                    }
                ]
            }
        },
        "/health": {
            "get": {
                "operationId": "health.live",
                "description": "Always answers `{\"status\":\"ok\"}` while the process runs. It touches neither the database nor\nRedis, so an orchestrator can use it to decide whether to restart the process.",
                "summary": "Liveness: the process is up",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/health/ready": {
            "get": {
                "operationId": "health.ready",
                "description": "Checks PostgreSQL and Redis. A failure answers 503 and names each dependency `ok` or `failed`,\nnever its address, version or connection string.",
                "summary": "Readiness: the dependencies answer",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "const": "ok"
                                                },
                                                "checks": {
                                                    "type": "object",
                                                    "properties": {
                                                        "database": {
                                                            "type": "string",
                                                            "enum": [
                                                                "failed",
                                                                "ok"
                                                            ]
                                                        },
                                                        "redis": {
                                                            "type": "string",
                                                            "enum": [
                                                                "failed",
                                                                "ok"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "database",
                                                        "redis"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "status",
                                                "checks"
                                            ]
                                        },
                                        {
                                            "type": "string"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "A dependency is unreachable; `checks` names each one `ok` or `failed`.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "securitySchemes": {
            "secretKey": {
                "type": "http",
                "description": "Server-to-server secret key (`hra_sk_...`) sent as `Authorization: Bearer`.",
                "scheme": "bearer"
            },
            "clientSecret": {
                "type": "http",
                "description": "Per-conversation `client_secret` JWT sent as `Authorization: Bearer`, always together with the publishable key.",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            },
            "publishableKey": {
                "type": "apiKey",
                "description": "Browser-safe publishable key (`hra_pk_...`); it grants nothing without the client secret.",
                "in": "header",
                "name": "X-HRA-Publishable-Key"
            }
        },
        "schemas": {
            "ApiKeyResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/components/schemas/KeyType"
                    },
                    "mode": {
                        "$ref": "#/components/schemas/KeyMode"
                    },
                    "key_prefix": {
                        "type": "string"
                    },
                    "scopes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "allowed_origins": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "revoked_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "last_used_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "rotated_from_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "type",
                    "mode",
                    "key_prefix",
                    "scopes",
                    "allowed_origins",
                    "expires_at",
                    "revoked_at",
                    "last_used_at",
                    "rotated_from_id",
                    "created_at"
                ],
                "title": "ApiKeyResource"
            },
            "CreateApiKeyRequest": {
                "type": "object",
                "properties": {
                    "type": {
                        "$ref": "#/components/schemas/KeyType"
                    },
                    "mode": {
                        "$ref": "#/components/schemas/KeyMode"
                    },
                    "scopes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Scope"
                        }
                    },
                    "allowed_origins": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "type",
                    "mode"
                ],
                "title": "CreateApiKeyRequest"
            },
            "CredentialSource": {
                "type": "string",
                "description": "Whose key a provider call would be made with, as the credential list reports it.\n",
                "enum": [
                    "account",
                    "platform",
                    "none"
                ],
                "title": "CredentialSource"
            },
            "IssuedApiKeyResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/components/schemas/KeyType"
                    },
                    "mode": {
                        "$ref": "#/components/schemas/KeyMode"
                    },
                    "key_prefix": {
                        "type": "string"
                    },
                    "scopes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "allowed_origins": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "revoked_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "last_used_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "rotated_from_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "key": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "type",
                    "mode",
                    "key_prefix",
                    "scopes",
                    "allowed_origins",
                    "expires_at",
                    "revoked_at",
                    "last_used_at",
                    "rotated_from_id",
                    "created_at",
                    "key"
                ],
                "title": "IssuedApiKeyResource"
            },
            "KeyMode": {
                "type": "string",
                "description": "A label of the key space and its prefix. It never changes provider selection and never partitions data: both modes read and write the same account's resources.\n",
                "enum": [
                    "live",
                    "test"
                ],
                "title": "KeyMode"
            },
            "KeyType": {
                "type": "string",
                "enum": [
                    "secret",
                    "publishable"
                ],
                "title": "KeyType"
            },
            "LlmCredentialResource": {
                "type": "object",
                "properties": {
                    "llm_provider": {
                        "type": "string"
                    },
                    "last_four": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "llm_provider",
                    "last_four"
                ],
                "title": "LlmCredentialResource"
            },
            "LlmModelResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "base_url": {
                        "type": "string"
                    },
                    "enabled": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "provider",
                    "model",
                    "display_name",
                    "base_url",
                    "enabled"
                ],
                "title": "LlmModelResource"
            },
            "ProviderCredentialResource": {
                "type": "object",
                "properties": {
                    "provider": {
                        "type": "string"
                    },
                    "source": {
                        "$ref": "#/components/schemas/CredentialSource"
                    },
                    "last_four": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "provider",
                    "source",
                    "last_four",
                    "updated_at"
                ],
                "title": "ProviderCredentialResource"
            },
            "PutCredentialRequest": {
                "type": "object",
                "description": "The body of a credential write, shared by provider and language-model credentials.",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                    }
                },
                "required": [
                    "api_key"
                ],
                "title": "PutCredentialRequest"
            },
            "RotateApiKeyRequest": {
