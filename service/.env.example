APP_NAME=HR-Avatar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (docker compose publishes it on host port 55432)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=hra
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (docker compose publishes it on host port 56379)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Signs the per-conversation client_secret. Required, at least 32 bytes:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
HRA_JWT_SECRET=

# Absolute base URL providers use to call back into this service
HRA_PUBLIC_BASE_URL=http://localhost:8100

HRA_RATE_LIMIT_SECRET=600
HRA_RATE_LIMIT_PUBLISHABLE=300
HRA_RATE_LIMIT_PREVIEW=10
HRA_RELEASE_DELAY_SECONDS=20
HRA_MAX_DURATION_CEILING=3600

# Optional platform provider keys (an account may store its own instead)
TAVUS_API_KEY=
HEYGEN_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
