<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <!-- Same suite, narrower coverage source: the zones held to 95 %. Slice 25 adds the conversation
         state machine; slice 26 adds the connect compare-and-set. -->
    <source>
        <include>
            <directory>app/Keys</directory>
            <directory>app/Accounts</directory>
            <directory>app/Http/Middleware</directory>
            <directory>app/Webhooks/Outbound</directory>
            <file>app/Conversations/ConversationLifecycle.php</file>
            <file>app/Conversations/IllegalTransition.php</file>
        </include>
    </source>
    <coverage>
        <report>
            <text outputFile="php://stdout"/>
        </report>
    </coverage>
    <php>
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="55432"/>
        <env name="DB_DATABASE" value="hra_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="REDIS_CLIENT" value="phpredis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="56379"/>
        <env name="HRA_JWT_SECRET" value="testing-secret-testing-secret-testing-secret"/>
        <env name="HRA_PUBLIC_BASE_URL" value="https://hra.example.test"/>
    </php>
</phpunit>
